# Gazette — .gitignore for Carbon development

# Build artifacts
build/
*.o
*.a
*.so
Gazette
Gazette.app/

# macOS metadata (resource forks, DS_Store)
.DS_Store
Thumbs.db
._*

# IDE files (if any)
.idea/
.vscode/
*.xcodeproj/

# Icon resources (generated, not committed)
*.icns
Resources/*.iconset/

# Temporary files
*.tmp
*~
