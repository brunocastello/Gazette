# Gazette — .gitignore for Carbon development

# Build output. Note the absence of *.o and *.a globs: Apple's Interfaces &
# Libraries ships static Open Transport glue as .o files and assembler
# includes as .a files, and ignoring those silently breaks the PPC link.
build/

.DS_Store

# Host test binary and its debug bundle (tests/host/Makefile builds these).
tests/host/run_tests
tests/host/run_tests.dSYM/

# Python bytecode from tools/
__pycache__/

# Reference screenshots dropped in the root to point at UI problems. They are
# working material, not part of the build.
/*.png

# Working notes dropped in docs/ to say what to build next. Same as the
# screenshots above: working material, not part of the build. The release
# notes are the one file in there that is.
docs/*
!docs/release-notes.md

# Working notes for driving Claude Code sessions: the prompt book and the
# pack's own readme. Kept beside the repo, not in it.
/PROMPTS.md
/PACK-README.md
